# Environment for the dev stack. Lives at ~/dayrim/dev.env, never in git.
DAYRIM_HOST=dayrim-dev.calypso.dedyn.io

TRUST_PROXY=1
ALLOWED_ORIGINS=https://dayrim-dev.calypso.dedyn.io

# Smaller limits: dev is one box and a couple of testers.
MAX_ROOMS=10
MAX_PLAYERS_PER_ROOM=4
MAX_CONNECTIONS=80
MAX_CONNECTIONS_PER_IP=8
