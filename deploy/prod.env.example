# Environment for the production stack. Lives at ~/dayrim/prod.env, never in git.
DAYRIM_HOST=dayrim.calypso.dedyn.io

# Traefik replaces X-Forwarded-For from outside, so per-address limits see the real visitor.
TRUST_PROXY=1
ALLOWED_ORIGINS=https://dayrim.calypso.dedyn.io

MAX_ROOMS=50
MAX_PLAYERS_PER_ROOM=4
MAX_CONNECTIONS=400
MAX_CONNECTIONS_PER_IP=12
