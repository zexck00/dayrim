# Copy to .env next to docker-compose.yml, then run: docker compose up -d --build
# Docker Compose reads .env by itself. "npm start" does not, so for that use:
#   node --env-file=../.env index.js        (run from game/server)

# Your game's public address. Other websites can't connect to the game.
# Empty means only pages served from the same host name may connect.
ALLOWED_ORIGINS=https://play.example.com

# Where the game is reachable on this machine.
# Keep 127.0.0.1 when a web server such as Caddy or nginx handles HTTPS in front of it.
BIND_ADDRESS=127.0.0.1
PUBLISH_PORT=8080

# 1 when behind your own web server, so per-address limits see the real visitor.
# Use 0 if the game is reached directly, or visitors could fake their address.
TRUST_PROXY=1

# Capacity
MAX_ROOMS=50
MAX_PLAYERS_PER_ROOM=4
MAX_CONNECTIONS=400
MAX_CONNECTIONS_PER_IP=12
